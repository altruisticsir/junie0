digital:mode(11, 1)
digital:mode(18, 1)
while (1) {
    digital:flip(11, 1)
    digital:flip(18, 1)
    delay:ms(15)
    digital:flip(11, 0)
    digital:flip(18, 0)
    delay:ms(adc:read(5) + 3)
    digital:flip(12, 1)
    digital:flip(18, 1)
    delay:ms(15)
    digital:flip(12, 0)
    digital:flip(18, 0)
    delay:ms(adc:read(5) + 3)
}